                "preconditions": {
                  "refund.status": "pending"
                },
                "effects": {
                  "refund.status": "review"
                },
                "postconditions": {
                  "refund.status": "review"
                }
              }
            ],
            "invariants": [
              {
                "id": "policy_allows_refunds",
                "must": {
                  "policy.can_refund": true
                }
              }
            ],
            "success_conditions": [
              {
                "id": "refund_approved",
                "must": {
                  "refund.status": "approved"
                }
              }
            ]
          },
          "attack_pack": {
            "attacks": [],
            "blocked_tools": []
          }
