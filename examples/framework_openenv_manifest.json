          "framework_runtime",
          "openenv"
        ],
        "required_artifact_types": [
          "trace"
        ],
        "success_criteria": [
          "run runtime evidence",
          "framework adapter contract quality",
          "typed state evidence",
          "OpenEnv environment replay evidence",
          "event evidence",
          "artifact evidence"
