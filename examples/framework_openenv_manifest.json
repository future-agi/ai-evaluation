          "framework_runtime",
          "method",
          "input",
          "output",
          "metadata",
          "state",
          "openenv",
          "event",
          "artifact"
        ],
        "framework_runtime_contract": {
          "framework": "openenv",
          "method": "run",
          "input_mode": "dict",
          "required_signals": [
            "method",
            "input",
            "output",
            "metadata",
            "state",
            "openenv",
            "event",
            "artifact"
